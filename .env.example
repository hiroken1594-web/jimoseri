# このファイルは見本です。実際の値は .env.local（Git 管理外）と Vercel の環境変数に設定します。
# `npm run env:init` を実行すると、ローカル開発用の .env.local が作られます。

# Postgres 接続先。ローカルは docker-compose.yml の DB、本番は Neon。
DATABASE_URL=
# Neon の「接続プールを通さない」URL（マイグレーション用。ローカルでは不要）
DATABASE_URL_UNPOOLED=

# 認証（Better Auth）。ランダムな文字列（32文字以上）。リカバリーコードのハッシュ化にも使うため、公開後は変更しない。
BETTER_AUTH_SECRET=
# このサービスの URL。Vercel では未設定でも自動で決まる。独自の URL を使う場合だけ設定する。
BETTER_AUTH_URL=

# 新規登録の受け付け方：open（誰でも）／invite（招待コードを知る関係者だけ）／closed（受け付けない）
# Vercel 上では、設定しない限り closed。
SIGNUP_MODE=
SIGNUP_INVITE_CODE=

# 運営者情報（利用規約・プライバシーポリシーに表示）。正式に決まってから設定する。
OPERATOR_NAME=
OPERATOR_EMAIL=

# OpenAI API キー（サーバー専用。未設定の場合、AI 抽出は使えず手入力のみで動作）
OPENAI_API_KEY=
# 使うモデル（未設定なら既定の低価格モデル）
OPENAI_MODEL=
# AI 抽出の1人あたり1日の上限回数（未設定は 30）
AI_DAILY_LIMIT=

# ローカルのテスト用アカウントのパスワード（npm run db:seed 用。本番では設定しない）
DEV_TEST_PASSWORD=

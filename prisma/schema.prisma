// AI地域商社 データモデル（02_spec.md 11-2 ＋ 03_spec_addendum.md）
// User / Session / Account / Verification / RateLimit は認証ライブラリ Better Auth が使うテーブル。
// ログインはユーザー名＋パスワード。メールアドレスは収集せず、メールも送らない。

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // Vercel Functions（ESM）で読み込めるよう、生成コード内の import に拡張子を付ける
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESTAURANT
  PRODUCER
  ADMIN
}

// 生産者・受渡場所の審査の状態
enum ReviewStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum Unit {
  KG
  PIECE
  BUNCH
  BAG
}

enum Grade {
  REGULAR
  IRREGULAR
}

// 規格外理由。傷み・鮮度低下とは区別する（仕様4章）。
enum IrregularReason {
  SHAPE
  SIZE
  SURPLUS
  OTHER
}

enum TimeMode {
  DEADLINE
  EXACT
}

// ---- 認証（Better Auth） ----

model User {
  id              String   @id
  name            String
  // ログインに使うユーザー名（半角英小文字・数字・_）
  username        String?  @unique
  displayUsername String?
  // Better Auth が内部で必要とする欄。実在しない形式の値（〜@users.jimoseri.invalid）を入れ、メールは送らない。
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 役割は登録時にサーバーが確定し、本人は変更できない。ADMIN は管理用コマンドでのみ付与する。
  role       Role?
  // 登録フォームの入力値（役割の希望・店舗名／農園名・地域）。確定後は参照しない。
  signupRole String?
  orgName    String?
  area       String?
  // 運営者による利用停止
  suspended  Boolean @default(false)

  sessions     Session[]
  accounts     Account[]
  recoveryCode RecoveryCode?
  producer     Producer?
  restaurant   Restaurant?
  aiUsages     AiUsage[]
  reports      Report[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// パスワードはここにハッシュ化して保存される（平文では保存しない）。
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// パスワードを忘れたときのためのリカバリーコード。コードそのものは保存せず、ハッシュだけを保存する。
// 利用者ごとに有効なコードは1つ。再発行すると、それまでのコードは無効になる。
model RecoveryCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime @default(now())
}

// 新規登録・ログイン試行・リカバリーコードの回数制限。key は IP やユーザー名のハッシュ。
model Throttle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Better Auth が内部で使う一時的なトークンの置き場
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ログイン試行などの回数制限
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---- 業務データ ----

model Restaurant {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  area        String
  // 住所（任意・本人と運営者だけが見る。他の利用者には公開しない）
  postalCode  String?
  prefecture  String?
  city        String?
  town        String?
  addressLine String?
  // お店の位置（地図検索の中心の初期値）。郵便番号・住所から候補を出し、本人が地図で確かめて保存する。非公開。
  latitude    Float?
  longitude   Float?
  demands     Demand[]
  favorites   Favorite[]
}

model Producer {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName       String
  area           String
  // 登録直後は承認待ち。承認済みの生産者の出品だけが仕入れ案に使われる。
  approvalStatus ReviewStatus     @default(PENDING)
  // 公開用の連絡先（任意）。show〜 が true の項目だけ飲食店に表示する。
  publicPhone    String?
  showPhone      Boolean          @default(false)
  publicEmail    String?
  showEmail      Boolean          @default(false)
  contactNote    String?
  // 住所（任意・本人と運営者だけが見る。他の利用者には公開しない）
  postalCode     String?
  prefecture     String?
  city           String?
  town           String?
  addressLine    String?
  // デモデータ（お試し用）の生産者。出品は飲食店の仕入れ案に使われない。
  isDemo         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  listings       Listing[]
  locations      PickupLocation[]
}

// 生産者が登録する受渡場所。同じ1件を選んだ出品どうしを「同じ場所」と判定する。
model PickupLocation {
  id           String       @id @default(cuid())
  name         String
  municipality String
  // 飲食店に表示する住所・目印（番地まで書くかは登録者が決める）
  address      String
  note         String       @default("")
  // 郵便番号から自動入力した住所の内訳（公開範囲は address と同じ）
  postalCode   String?
  prefecture   String?
  town         String?
  // 地図上の位置。showOnMap が true で、運営者が確認済みの場所だけを地図・半径検索に出す
  latitude     Float?
  longitude    Float?
  showOnMap    Boolean      @default(false)
  // 受け取りできる曜日・時間の目安（例：平日10〜16時）
  hours        String       @default("")
  // 新しい場所は運営者の確認後に利用可能になる
  status       ReviewStatus @default(PENDING)
  createdById  String?
  createdBy    Producer?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // デモデータ（お試し用）の場所。他の生産者の選択肢や、飲食店の受取エリアには出さない。
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  listings     Listing[]

  @@index([status])
}

model Item {
  id        String    @id @default(cuid())
  name      String    @unique
  aliases   String[]
  sortOrder Int       @default(0)
  listings  Listing[]
  demands   Demand[]
}

model Listing {
  id               String           @id @default(cuid())
  producerId       String
  producer         Producer         @relation(fields: [producerId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item             @relation(fields: [itemId], references: [id])
  variety          String?
  grade            Grade            @default(REGULAR)
  irregularReason  IrregularReason?
  // 既存注文分を除いて今回販売に回せる量
  quantity         Decimal          @db.Decimal(10, 3)
  unit             Unit
  // 税込単価（円／単位）
  unitPriceTaxIncl Int
  minQuantity      Decimal          @db.Decimal(10, 3)
  stepQuantity     Decimal          @db.Decimal(10, 3)
  pickupLocationId String
  pickupLocation   PickupLocation   @relation(fields: [pickupLocationId], references: [id])
  pickupStart      DateTime
  pickupEnd        DateTime
  // 生産者本人による公開／停止
  isPublished      Boolean          @default(true)
  // 運営者による停止
  adminSuspended   Boolean          @default(false)
  // デモデータ（お試し用）。飲食店の仕入れ案には使わない。npm run demo:remove で一括削除できる。
  isDemo           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  favorites        Favorite[]

  @@index([itemId, isPublished])
  @@index([producerId])
}

// 飲食店が確定した仕入れ希望条件（履歴）。仕入れ案そのものは保存しない（仕様11-2）。
model Demand {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rawText            String?
  itemId             String
  item               Item       @relation(fields: [itemId], references: [id])
  quantity           Decimal    @db.Decimal(10, 3)
  unit               Unit
  timeMode           TimeMode
  // DEADLINE: 期限の日 / EXACT: 指定日（日本時間の YYYY-MM-DD）
  date               String
  time               String?
  // 受取エリア（市区町村）。null は指定なし。
  municipality       String?
  budgetMaxYen       Int?
  allowIrregular     Boolean
  // 複数の場所での受け取りを許可するか（初期値オフ）
  allowMultiLocation Boolean    @default(false)
  // デモモード（デモデータだけで計算した仕入れ希望）
  demoMode           Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// AI 抽出の利用回数（利用者ごと・日本時間の1日ごと）
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
}

// 飲食店の「気になる」（お気に入り）。注文・予約・在庫の確保ではない。出品が削除されると一緒に消える。
model Favorite {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, listingId])
}

enum ReportTarget {
  LISTING
  PRODUCER
  RESTAURANT
}

enum ReportReason {
  FALSE_INFO
  INAPPROPRIATE
  NUISANCE
  FRAUD
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// 利用者からの通報。内容は運営者だけが見る。通報した人は通報された側に知らされない。
model Report {
  id          String         @id @default(cuid())
  reporterId  String?
  reporter    User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType  ReportTarget
  targetId    String
  // 通報時点の対象の名前（対象が削除されても運営者が分かるように残す）
  targetLabel String
  reason      ReportReason
  detail      String         @default("")
  status      ReportStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  actions     ReportAction[]

  @@index([status, createdAt])
  @@index([reporterId, targetType, targetId])
}

// 通報への対応の記録（状態の変更・停止などの操作）
model ReportAction {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorName String
  action    String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([reportId])
}

// 郵便番号・地名検索の結果の一時保存（外部サービスへの問い合わせ回数を減らす）
model GeoCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
}

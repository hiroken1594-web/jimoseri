// AI地域商社 データモデル（02_spec.md 11-2 ＋ 03_spec_addendum.md）
// User / Session / Account / Verification / RateLimit は認証ライブラリ Better Auth が使うテーブル。
// ログインはユーザー名＋パスワード。メールアドレスは収集せず、メールも送らない。

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // Vercel Functions（ESM）で読み込めるよう、生成コード内の import に拡張子を付ける
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESTAURANT
  PRODUCER
  ADMIN
}

// 生産者・受渡場所の審査の状態
enum ReviewStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED // 運営者が却下した（理由は reviewNote）。内容を直すと再申請（PENDING）になる
}

enum Unit {
  KG
  PIECE
  BUNCH
  BAG
}

enum Grade {
  REGULAR
  IRREGULAR
}

// 規格外理由。傷み・鮮度低下とは区別する（仕様4章）。
enum IrregularReason {
  SHAPE
  SIZE
  SURPLUS
  OTHER
}

enum TimeMode {
  DEADLINE
  EXACT
}

// ---- 認証（Better Auth） ----

model User {
  id              String   @id
  name            String
  // ログインに使うユーザー名（半角英小文字・数字・_）
  username        String?  @unique
  displayUsername String?
  // Better Auth が内部で必要とする欄。実在しない形式の値（〜@users.jimoseri.invalid）を入れ、メールは送らない。
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 役割は登録時にサーバーが確定し、本人は変更できない。ADMIN は管理用コマンドでのみ付与する。
  role          Role?
  // 登録フォームの入力値（役割の希望・店舗名／農園名・地域）。確定後は参照しない。
  signupRole    String?
  orgName       String?
  area          String?
  // 運営者による利用停止
  suspended     Boolean    @default(false)
  // 電話番号（数字だけにそろえて保存。他の利用者には原則として公開しない）
  phone         String?
  // SMS などで本人の番号と確認できたか（いまは確認の仕組みがないため、常に false）
  phoneVerified Boolean    @default(false)
  // 取引相手に電話番号を見せてよい範囲（本人の同意。初期値は見せない）
  phoneShare    PhoneShare @default(NONE)

  sessions      Session[]
  accounts      Account[]
  recoveryCode  RecoveryCode?
  producer      Producer?
  restaurant    Restaurant?
  aiUsages      AiUsage[]
  reports       Report[]
  chatMessages  ChatMessage[]
  notifications Notification[]
  reviews       Review[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// パスワードはここにハッシュ化して保存される（平文では保存しない）。
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// パスワードを忘れたときのためのリカバリーコード。コードそのものは保存せず、ハッシュだけを保存する。
// 利用者ごとに有効なコードは1つ。再発行すると、それまでのコードは無効になる。
model RecoveryCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  createdAt DateTime @default(now())
}

// 新規登録・ログイン試行・リカバリーコードの回数制限。key は IP やユーザー名のハッシュ。
model Throttle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Better Auth が内部で使う一時的なトークンの置き場
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ログイン試行などの回数制限
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---- 業務データ ----

model Restaurant {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  area            String
  // 住所（任意・本人と運営者だけが見る。他の利用者には公開しない）
  postalCode      String?
  prefecture      String?
  city            String?
  town            String?
  addressLine     String?
  // お店の位置（地図検索の中心の初期値）。郵便番号・住所から候補を出し、本人が地図で確かめて保存する。非公開。
  latitude        Float?
  longitude       Float?
  // 住所の建物名・部屋番号（null は未回答、空文字は「建物名なし」）
  building        String?
  // 生産者からの取引提案を受け取るか（初期値は受け取らない）。受け取る飲食店だけが、生産者の提案先の一覧に出る
  acceptProposals Boolean         @default(false)
  // デモデータ（お試し用）の飲食店。デモの生産者は、デモの飲食店にだけ提案できる
  isDemo          Boolean         @default(false)
  demands         Demand[]
  favorites       Favorite[]
  matches         MatchRequest[]
  blocks          ProposalBlock[]
}

model Producer {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName       String
  area           String
  // 登録直後は承認待ち。承認済みの生産者の出品だけが仕入れ案に使われる。
  approvalStatus ReviewStatus     @default(PENDING)
  // 公開用の連絡先（任意）。show〜 が true の項目だけ飲食店に表示する。
  publicPhone    String?
  showPhone      Boolean          @default(false)
  publicEmail    String?
  showEmail      Boolean          @default(false)
  contactNote    String?
  // 住所（任意・本人と運営者だけが見る。他の利用者には公開しない）
  postalCode     String?
  prefecture     String?
  city           String?
  town           String?
  addressLine    String?
  // デモデータ（お試し用）の生産者。出品は飲食店の仕入れ案に使われない。
  isDemo         Boolean          @default(false)
  // 住所の建物名・部屋番号（null は未回答、空文字は「建物名なし」）
  building       String?
  // 審査の結果（却下の理由）と、審査した日時
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  listings       Listing[]
  locations      PickupLocation[]
  matches        MatchRequest[]
  blockedBy      ProposalBlock[]
}

// 生産者が登録する受渡場所。同じ1件を選んだ出品どうしを「同じ場所」と判定する。
model PickupLocation {
  id           String       @id @default(cuid())
  name         String
  municipality String
  // 飲食店に表示する住所・目印（番地まで書くかは登録者が決める）
  address      String
  note         String       @default("")
  // 郵便番号から自動入力した住所の内訳（公開範囲は address と同じ）
  postalCode   String?
  prefecture   String?
  // 建物名・部屋番号（null は未回答、空文字は「建物名なし」）
  building     String?
  // 審査の結果（却下の理由）と、審査した日時
  reviewNote   String?
  reviewedAt   DateTime?
  town         String?
  // 地図上の位置。showOnMap が true で、運営者が確認済みの場所だけを地図・半径検索に出す
  latitude     Float?
  longitude    Float?
  showOnMap    Boolean      @default(false)
  // 受け取りできる曜日・時間の目安（例：平日10〜16時）
  hours        String       @default("")
  // 新しい場所は運営者の確認後に利用可能になる
  status       ReviewStatus @default(PENDING)
  createdById  String?
  createdBy    Producer?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // デモデータ（お試し用）の場所。他の生産者の選択肢や、飲食店の受取エリアには出さない。
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  listings     Listing[]

  @@index([status])
}

model Item {
  id        String    @id @default(cuid())
  name      String    @unique
  aliases   String[]
  sortOrder Int       @default(0)
  listings  Listing[]
  demands   Demand[]
}

model Listing {
  id                String           @id @default(cuid())
  producerId        String
  producer          Producer         @relation(fields: [producerId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item             @relation(fields: [itemId], references: [id])
  variety           String?
  grade             Grade            @default(REGULAR)
  irregularReason   IrregularReason?
  // 既存注文分を除いて今回販売に回せる量
  quantity          Decimal          @db.Decimal(10, 3)
  unit              Unit
  // 税込単価（円／単位）
  unitPriceTaxIncl  Int
  minQuantity       Decimal          @db.Decimal(10, 3)
  stepQuantity      Decimal          @db.Decimal(10, 3)
  pickupLocationId  String
  pickupLocation    PickupLocation   @relation(fields: [pickupLocationId], references: [id])
  // 1日だけの出品：受渡の開始・終了。期間の出品：最初の回の開始・最後の回の終了。
  pickupStart       DateTime
  pickupEnd         DateTime
  // 期間の出品だけ：受け取れる曜日（日曜=1 … 土曜=64 の合計）と、その日の時間帯（0時からの分）。null なら1日だけの出品。
  pickupWeekdays    Int?
  pickupStartMin    Int?
  pickupEndMin      Int?
  // 商品の説明（任意）と、配送に対応できるか・配送するときの送料の目安（null は相談）
  description       String           @default("")
  deliveryAvailable Boolean          @default(false)
  shippingFeeYen    Int?
  // 生産者本人による公開／停止
  isPublished       Boolean          @default(true)
  // 運営者による停止
  adminSuspended    Boolean          @default(false)
  // デモデータ（お試し用）。飲食店の仕入れ案には使わない。npm run demo:remove で一括削除できる。
  isDemo            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  favorites         Favorite[]
  matches           MatchRequest[]

  @@index([itemId, isPublished])
  @@index([producerId])
}

// 飲食店が確定した仕入れ希望条件（履歴）。仕入れ案そのものは保存しない（仕様11-2）。
model Demand {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rawText            String?
  itemId             String
  item               Item       @relation(fields: [itemId], references: [id])
  quantity           Decimal    @db.Decimal(10, 3)
  unit               Unit
  timeMode           TimeMode
  // DEADLINE: 期限の日 / EXACT: 指定日（日本時間の YYYY-MM-DD）
  date               String
  time               String?
  // 受取エリア：都道府県（必須。以前の履歴は null）と市区町村（null は指定なし）
  prefecture         String?
  municipality       String?
  budgetMaxYen       Int?
  allowIrregular     Boolean
  // 複数の場所での受け取りを許可するか（初期値オフ）
  allowMultiLocation Boolean    @default(false)
  // デモモード（デモデータだけで計算した仕入れ希望）
  demoMode           Boolean    @default(false)
  createdAt          DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// AI 抽出の利用回数（利用者ごと・日本時間の1日ごと）
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  count  Int    @default(0)

  @@unique([userId, day])
}

// 飲食店の「気になる」（お気に入り）。注文・予約・在庫の確保ではない。出品が削除されると一緒に消える。
model Favorite {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, listingId])
}

enum ReportTarget {
  LISTING
  PRODUCER
  RESTAURANT
  REVIEW
}

// 電話番号を取引相手に見せる範囲（本人が選ぶ）
enum PhoneShare {
  NONE // 見せない
  MATCHED // マッチング成立後の取引相手にだけ
  ANYTIME // 相談中（承認前）の取引相手にも
}

enum ReportReason {
  FALSE_INFO
  INAPPROPRIATE
  NUISANCE
  FRAUD
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// 利用者からの通報。内容は運営者だけが見る。通報した人は通報された側に知らされない。
model Report {
  id          String         @id @default(cuid())
  reporterId  String?
  reporter    User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType  ReportTarget
  targetId    String
  // 通報時点の対象の名前（対象が削除されても運営者が分かるように残す）
  targetLabel String
  reason      ReportReason
  detail      String         @default("")
  status      ReportStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  actions     ReportAction[]

  @@index([status, createdAt])
  @@index([reporterId, targetType, targetId])
}

// 通報への対応の記録（状態の変更・停止などの操作）
model ReportAction {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorName String
  action    String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([reportId])
}

// 郵便番号・地名検索の結果の一時保存（外部サービスへの問い合わせ回数を減らす）
model GeoCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
}

// ---- マッチング（飲食店 → 生産者への依頼）とチャット ----
// 依頼は生産者ごと（出品ごと）に作り、生産者が「承認」したときだけマッチング成立とする。
// 成立しても、在庫の確保・注文の確定・決済・配送はしない（条件は当事者がチャットで相談する）。

enum MatchStatus {
  PENDING // 相談中（提案を受けた側の返事待ち。チャットは使える）
  ACCEPTED // マッチング成立（取引準備中。条件を調整する）
  AGREED // 取引条件に双方が合意
  COMPLETED // 双方が取引完了を確認
  DECLINED // 提案を受けた側が辞退した
  CANCELLED // 提案した側が取り下げた
}

// 受渡の方法
enum DeliveryMethod {
  PICKUP // 生産者の指定場所で受け取る
  DELIVERY // 飲食店の指定場所に配送する
  DISCUSS // 双方で相談して決める
}

// 送料の負担
enum ShippingPayer {
  UNDECIDED
  RESTAURANT
  PRODUCER
}

model MatchRequest {
  id                    String          @id @default(cuid())
  restaurantId          String
  restaurant            Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  producerId            String
  producer              Producer        @relation(fields: [producerId], references: [id], onDelete: Cascade)
  // 依頼のもとになった出品。出品が削除されても、依頼とチャットは残す
  listingId             String?
  listing               Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // 依頼した時点の内容（あとで出品が変わっても、何を頼んだかが分かるように写しておく）
  itemName              String
  variety               String?
  quantity              Decimal         @db.Decimal(10, 3)
  unit                  Unit
  unitPriceTaxIncl      Int
  pickupStart           DateTime
  pickupEnd             DateTime
  locationName          String
  message               String          @default("")
  // 提案した側（飲食店からの依頼か、生産者からの提案か）。返事をするのは反対側
  initiator             Role            @default(RESTAURANT)
  // 取引条件（相談で変わる。送料が null のときは「未確定」）
  deliveryMethod        DeliveryMethod  @default(PICKUP)
  deliveryPlace         String          @default("")
  shippingFeeYen        Int?
  shippingPayer         ShippingPayer   @default(UNDECIDED)
  termsNote             String          @default("")
  // いまの条件への合意（条件が変わると取り消す）と、取引完了の確認
  restaurantAgreedAt    DateTime?
  producerAgreedAt      DateTime?
  restaurantCompletedAt DateTime?
  producerCompletedAt   DateTime?
  // 同じ仕入れ案からまとめて送った依頼の目印
  groupId               String?
  status                MatchStatus     @default(PENDING)
  declineReason         String?
  // デモデータ（お試し用）の出品への依頼
  isDemo                Boolean         @default(false)
  createdAt             DateTime        @default(now())
  respondedAt           DateTime?
  // 新着メッセージの判定に使う、それぞれが最後に開いた日時
  restaurantReadAt      DateTime?
  producerReadAt        DateTime?
  messages              ChatMessage[]
  proposals             TermsProposal[]
  reviews               Review[]
  notifications         Notification[]

  @@index([restaurantId, createdAt])
  @@index([producerId, status])
}

model ChatMessage {
  id           String       @id @default(cuid())
  matchId      String
  match        MatchRequest @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // 送った人（サーバーがログイン中の利用者から決める。退会しても会話は残す）
  senderUserId String?
  sender       User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderRole   Role
  // 種類：TEXT（メッセージ）・SYSTEM（承認・合意などの記録）・PROPOSAL（条件の提案カード）
  kind         ChatKind     @default(TEXT)
  proposalId   String?
  body         String
  // 再送したときに二重に保存しないための、画面側で付ける番号
  clientId     String
  createdAt    DateTime     @default(now())

  @@unique([matchId, clientId])
  @@index([matchId, createdAt])
}

enum ChatKind {
  TEXT
  SYSTEM
  PROPOSAL
}

// 取引条件の変更提案（マッチング成立後に、どちらからでも出せる）。相手が承諾すると取引条件になり、双方の合意になる
enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED // 新しい提案が出たため無効
}

model TermsProposal {
  id               String         @id @default(cuid())
  matchId          String
  match            MatchRequest   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposerRole     Role
  quantity         Decimal        @db.Decimal(10, 3)
  unitPriceTaxIncl Int
  deliveryMethod   DeliveryMethod
  deliveryPlace    String         @default("")
  pickupStart      DateTime
  pickupEnd        DateTime
  shippingFeeYen   Int?
  shippingPayer    ShippingPayer  @default(UNDECIDED)
  note             String         @default("")
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  respondedAt      DateTime?

  @@index([matchId, createdAt])
}

// 飲食店が「この生産者からの提案を受け取らない」とした組み合わせ
model ProposalBlock {
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  producerId   String
  producer     Producer   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([restaurantId, producerId])
}

// アプリ内の通知（DB に保存し、既読・未読を管理する）
enum NotificationKind {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_DECLINED
  NEW_MESSAGE
  TERMS_PROPOSED
  TERMS_AGREED
  COMPLETION_REQUESTED
  COMPLETED
  REVIEW_REQUESTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String           @default("")
  // 押したときに開く画面（アプリ内のパス）
  link      String
  matchId   String?
  match     MatchRequest?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

// 取引完了後の相互レビュー（1取引につき1人1回）
model Review {
  id             String       @id @default(cuid())
  matchId        String
  match          MatchRequest @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reviewerRole   Role
  reviewerUserId String?
  reviewer       User?        @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)
  // 評価される側（生産者または飲食店の ID）
  targetRole     Role
  targetId       String
  rating         Int
  satisfaction   Int
  politeness     Int
  smoothness     Int
  comment        String       @default("")
  // 運営者による非公開
  hidden         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([matchId, reviewerRole])
  @@index([targetRole, targetId])
}

// 運営者の審査の記録（承認・却下と理由）。申請の種類と対象の ID で、だれが・いつ・どう判断したかを残す
model ReviewDecision {
  id          String       @id @default(cuid())
  targetType  String // PRODUCER（生産者の登録申請）・LOCATION（受渡拠点の登録申請）
  targetId    String
  decision    ReviewStatus
  reason      String       @default("")
  adminUserId String?
  createdAt   DateTime     @default(now())

  @@index([targetType, targetId])
}
